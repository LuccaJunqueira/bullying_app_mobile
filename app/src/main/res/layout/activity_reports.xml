<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_gradiente_telaprofessor">

    <!-- Linha 1 - TÍTULO -->
    <TextView
        android:id="@+id/tvReportsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RELATOS"
        android:gravity="center"
        android:textColor="#7F7FFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />


    <!-- Linha 2 - BARRA DE PESQUISA (melhorada) -->
    <EditText
        android:id="@+id/etPesquisa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Pesquisar..."
        android:background="@drawable/bg_edittext_telaprof"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#000000"
        android:textColorHint="#666666"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />


    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <!-- Botão Novo Relato -->
    <Button
        android:id="@+id/btnSendReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:text="NOVO RELATO"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

</LinearLayout>
